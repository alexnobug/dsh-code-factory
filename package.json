{
  "name": "dsh-code-factory",
  "version": "0.2.3",
  "description": "Code Factory for DeepSeek Harness: an opinionated software-team pipeline (role registry / task router / stage gates / DoD) driving durable sub-agent members, with a full-width cockpit panel in the Web GUI",
  "license": "MIT",
  "author": "alex_bug",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-code-factory-doctor": "scripts/doctor.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./types/client.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/client/**",
    "cordis.patch.yml",
    "compatibility.json",
    "README.md",
    "README_ZH.md",
    "CHANGELOG.md",
    "LICENSE",
    "ROLLBACK.md",
    "types",
    "scripts/doctor.mjs",
    "scripts/profile-backup.mjs"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "multi-agent",
    "pipeline",
    "code-factory",
    "agent-forge"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsdown -c tsdown.config.ts && node scripts/check-bundle.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "test:self": "node scripts/check-docs-selftest.mjs",
    "test:self:pack": "node scripts/check-pack-selftest.mjs",
    "verify": "node scripts/verify.mjs",
    "drill:gates": "node scripts/gates-drill.mjs --quiet",
    "drill:engine": "node scripts/engine-drill.mjs --quiet",
    "drill:delivery": "node scripts/delivery-drill.mjs --quiet",
    "check:coverage": "node scripts/coverage-gate.mjs --quiet",
    "check:coverage:self": "node scripts/coverage-gate.mjs --selftest",
    "smoke:load": "node scripts/load-smoke.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:docs:strict": "node scripts/check-docs.mjs --strict",
    "check:docs:concurrent": "node scripts/check-docs.mjs --concurrent",
    "check:graph": "node scripts/graph-gate.mjs",
    "check:graph:self": "node scripts/graph-gate.mjs --selftest",
    "check:ci": "node scripts/check-ci-parity.mjs",
    "check:ci:self": "node scripts/check-ci-parity.mjs --selftest",
    "check:changelog": "node scripts/check-changelog.mjs",
    "check:changelog:self": "node scripts/check-changelog.mjs --selftest",
    "hooks:install": "node scripts/install-hooks.mjs",
    "hooks:check": "node scripts/install-hooks.mjs --check",
    "doctor:install": "node scripts/doctor.mjs",
    "backup": "node scripts/profile-backup.mjs backup",
    "backup:verify": "node scripts/profile-backup.mjs verify",
    "backup:drill": "node scripts/profile-backup.mjs drill",
    "release:check": "pnpm run check:ci && pnpm run check:ci:self && pnpm run typecheck && pnpm run build && pnpm run check:graph && pnpm run verify && pnpm run drill:engine && pnpm run drill:gates && pnpm run drill:delivery && pnpm run check:coverage && pnpm run check:coverage:self && pnpm run check:docs:strict && pnpm run test:self && pnpm run test:self:pack && pnpm run check:changelog && pnpm run check:changelog:self && pnpm run check:graph:self && pnpm run hooks:check && pnpm run doctor:install && pnpm run backup:drill && pnpm run check:pack",
    "release:publish": "pnpm run release:check && pnpm run smoke:load",
    "prepare": "node scripts/install-hooks.mjs",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run release:publish"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-connection": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-chat": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-commands": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-subagent": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.3",
    "@deepseek-ai/schemastery": "^3.19.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-chat": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.3",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.3",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "lightningcss": "^1.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3"
  }
}
